{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Generic",
                "CMAKE_SYSTEM_PROCESSOR": "arm",
                "CMAKE_C_COMPILER": "arm-none-eabi-gcc",
                "CMAKE_ASM_COMPILER": "arm-none-eabi-gcc",
                "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
                "CMAKE_C_FLAGS_INIT": "-mcpu=cortex-m4 -mthumb -ffunction-sections -fdata-sections",
                "CMAKE_ASM_FLAGS_INIT": "-mcpu=cortex-m4 -mthumb -x assembler-with-cpp"
            }
        },
        {
            "name": "Debug",
            "inherits": "base",
            "displayName": "Debug (STM32F407, arm-none-eabi)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        }
    ]
}
